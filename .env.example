# Copia este archivo a `.env` y completa. Nunca hagas commit de `.env`.

# NASA Earthdata (https://urs.earthdata.nasa.gov/)
# Opcion A (recomendada): token
EARTHDATA_TOKEN=
# Opcion B: usuario y contrasena
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Backblaze B2 (solo si usas scripts/upload_to_b2.py)
# https://www.backblaze.com/b2/cloud-storage.html
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
